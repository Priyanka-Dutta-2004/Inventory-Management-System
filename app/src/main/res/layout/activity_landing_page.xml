<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:id="@+id/main"
    tools:context=".LandingPageActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="280dp"
                android:layout_height="120dp"
                android:src="@drawable/profile"
                android:contentDescription="Inventory Management System Logo"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="80dp"/>

            <!-- App Title -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inventory\nManagement"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:textAlignment="center"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/imgLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Subtitle -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your role to continue"
                android:textSize="16sp"
                android:textColor="@color/primary_dark"
                android:alpha="0.6"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/appTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@id/subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp">

                    <!-- Select User Label -->
                    <TextView
                        android:id="@+id/selectUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Get Started"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- User Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/userBtn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:text="User Login"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_person"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:layout_constraintTop_toBottomOf="@id/selectUser"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>


                    <!-- Manager Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/managerBtn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="Manager Login"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_person"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:layout_constraintTop_toBottomOf="@id/userBtn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>


                    <!-- Admin Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/adminBtn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="Admin Login"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_admin"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button"
                        app:layout_constraintTop_toBottomOf="@id/managerBtn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- IT Support Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/itSupportBtn"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:text="IT Support Login"
                        android:textSize="16sp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_admin"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="12dp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:layout_constraintTop_toBottomOf="@id/adminBtn"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Version Info -->
            <TextView
                android:id="@+id/versionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0"
                android:textSize="12sp"
                android:textColor="@color/primary_dark"
                android:alpha="0.4"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
