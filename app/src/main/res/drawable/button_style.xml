<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/btn_pressed_start"
                android:endColor="@color/btn_pressed_end"
                android:angle="45"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/btn_border"/>
        </shape>
    </item>

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_focus"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/btn_border"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/btn_start"
                android:endColor="@color/btn_end"
                android:angle="45"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/btn_border"/>
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="10dp"
                android:bottom="10dp"/>
        </shape>
    </item>

</selector>