<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.InventoryManagementSystem" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background_light</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>

        <!-- Default Button Background -->
        <item name="buttonBackground">@drawable/button_style</item>

        <!-- Changing the Font Family -->
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="fontFamily">@font/cinzel</item>

        <!--    Changing the Card Style    -->
        <item name="materialCardViewStyle">@style/Widget.Inventory.DashboardCard</item>

    </style>

</resources>